diff --git a/src/audio-provider.js b/src/audio-provider.js
new file mode 100644
index 0000000..c77ab45
--- /dev/null
+++ b/src/audio-provider.js
@@ -0,0 +1,43 @@
+import { ApiError } from './errors.js';
+import { ensureAudio } from './config.js';
+import { SYSTEM_PROMPT } from './prompt.js';
+
+// Native Gemini audio input: the original recording is passed directly to the model.
+export function createAudioProvider(config, fetchImpl = fetch) {
+  return {
+    async extract(input) {
+      ensureAudio(config);
+      try {
+        const response = await fetchImpl(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(config.audioModel)}:generateContent`, {
+          method: 'POST', redirect: 'error', signal: AbortSignal.timeout(config.timeout),
+          headers: { 'Content-Type': 'application/json', 'x-goog-api-key': config.audioKey },
+          body: JSON.stringify({
+            systemInstruction: { parts: [{ text: SYSTEM_PROMPT }] },
+            contents: [{ role: 'user', parts: [
+              { text: 'Escuchá esta cuenta y devolvé los movimientos con su importe y detalle en el JSON solicitado.' },
+              { inlineData: { mimeType: input.audio.mimeType, data: input.audio.base64 } },
+            ] }],
+            generationConfig: { responseMimeType: 'application/json', maxOutputTokens: 6000 },
+          }),
+        });
+        if (!response.ok) {
+          const code = response.status === 401 || response.status === 403 ? 'AI_AUTH_FAILED'
+            : [400, 404, 422].includes(response.status) ? 'AI_REQUEST_REJECTED' : 'AI_UNAVAILABLE';
+          throw new ApiError(response.status === 429 ? 503 : 502, code, 'El proveedor de audio no pudo procesar la solicitud.');
+        }
+        const raw = await response.json();
+        const candidate = raw.candidates?.[0];
+        const text = candidate?.content?.parts?.filter(part => !part.thought && typeof part.text === 'string').map(part => part.text).join('');
+        if (candidate?.finishReason !== 'STOP' || !text)
+          throw new ApiError(502, 'AI_INVALID_RESPONSE', 'La lectura del audio quedó incompleta.');
+        try { return JSON.parse(text); }
+        catch { throw new ApiError(502, 'AI_INVALID_RESPONSE', 'La IA devolvió un formato inválido.'); }
+      } catch (error) {
+        if (error instanceof ApiError) throw error;
+        if (error.name === 'TimeoutError' || error.name === 'AbortError')
+          throw new ApiError(504, 'AI_TIMEOUT', 'La lectura del audio demoró demasiado.');
+        throw new ApiError(502, 'AI_UNAVAILABLE', 'No se pudo consultar al proveedor de audio.');
+      }
+    },
+  };
+}
