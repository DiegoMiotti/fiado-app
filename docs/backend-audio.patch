diff --git a/test/audio.test.js b/test/audio.test.js
new file mode 100644
index 0000000..a7b673e
--- /dev/null
+++ b/test/audio.test.js
@@ -0,0 +1,88 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer } from 'node:http';
+import { createHash } from 'node:crypto';
+import { once } from 'node:events';
+import { validateRequest, MAX_AUDIO } from '../src/validation.js';
+import { loadConfig } from '../src/config.js';
+import { createProvider } from '../src/provider.js';
+import { createHandler } from '../src/app.js';
+
+const token = 'a'.repeat(43);
+const cfg = extra => loadConfig({ APP_TOKENS_JSON: JSON.stringify({ test: createHash('sha256').update(token).digest('hex') }),
+  AUDIO_API_KEY: 'fake-audio-key', AUDIO_MODEL: 'test-model', ...extra });
+const audio = { mimeType: 'audio/mp4', base64: Buffer.from('0000ftypM4A 0000').toString('base64') };
+const data = { clientes: [{ cliente: 'Leo', cliente_requiere_revision: false, operaciones: [
+  { tipo: 'cargo', referencia: null, detalle: 'cerveza', importe: 4000, requiere_revision: false },
+  { tipo: 'cargo', referencia: null, detalle: 'salchichas', importe: 300, requiere_revision: false },
+] }], advertencias: [] };
+
+test('Configuración: reutiliza Gemini existente sin reutilizar claves de otros proveedores', () => {
+  const existing = cfg({ AUDIO_API_KEY: '', AUDIO_MODEL: '', AI_BASE_URL: 'https://generativelanguage.googleapis.com/v1beta/openai', AI_API_KEY: 'existing-gemini', AI_MODEL: 'existing-model' });
+  assert.equal(existing.audioKey, 'existing-gemini');
+  assert.equal(existing.audioModel, 'existing-model');
+  assert.equal(cfg({ AUDIO_API_KEY: '', AI_API_KEY: 'other-provider' }).audioKey, '');
+});
+
+test('Audio original: formato, límites y exclusión mutua de fuentes', () => {
+  assert.deepEqual(validateRequest({ audio }).audio, audio);
+  for (const body of [{ audio, text: 'x' }, { audio, image: {} }, { audio: null },
+    { audio: { ...audio, mimeType: 'audio/wav' } }, { audio: { ...audio, base64: '???=' } },
+    { audio: { ...audio, base64: Buffer.from('no es audio mp4').toString('base64') } },
+    { audio: { ...audio, transcript: 'inventado' } }]) assert.throws(() => validateRequest(body));
+  assert.throws(() => validateRequest({ audio: { ...audio, base64: 'A'.repeat(Math.ceil(MAX_AUDIO / 3) * 4 + 4) } }), e => e.status === 413);
+});
+
+test('Proveedor Gemini recibe los mismos bytes de audio; no recibe agenda ni transcripción local', async () => {
+  let payload;
+  const provider = createProvider(cfg(), async (url, options) => {
+    assert.match(url, /^https:\/\/generativelanguage.googleapis.com\/v1beta\/models\/test-model:generateContent$/);
+    assert.equal(options.headers['x-goog-api-key'], 'fake-audio-key');
+    payload = JSON.parse(options.body);
+    return Response.json({ candidates: [{ finishReason: 'STOP', content: { parts: [{ text: JSON.stringify(data) }] } }] });
+  });
+  assert.deepEqual(await provider.extract({ audio, clients: [{ id: 'secret', name: 'Private' }] }), data);
+  const inline = payload.contents[0].parts[1].inlineData;
+  assert.deepEqual(inline, { mimeType: 'audio/mp4', data: audio.base64 });
+  assert.doesNotMatch(JSON.stringify(payload), /Private|secret|Transcripción a estructurar/);
+  assert.equal(payload.generationConfig.responseMimeType, 'application/json');
+});
+
+test('Audio: errores del proveedor y salida incompleta no filtran cuerpos', async () => {
+  for (const [fetchImpl, code] of [
+    [async () => new Response('private audio', { status: 401 }), 'AI_AUTH_FAILED'],
+    [async () => new Response('private audio', { status: 429 }), 'AI_UNAVAILABLE'],
+    [async () => Response.json({ candidates: [{ finishReason: 'MAX_TOKENS' }] }), 'AI_INVALID_RESPONSE'],
+    [async () => Response.json({ candidates: [{ finishReason: 'STOP', content: { parts: [{ text: 'invalid' }] } }] }), 'AI_INVALID_RESPONSE'],
+    [async () => { throw new DOMException('timeout', 'TimeoutError'); }, 'AI_TIMEOUT'],
+  ]) await assert.rejects(createProvider(cfg(), fetchImpl).extract({ audio }), e => e.code === code && !e.message.includes('private audio'));
+});
+
+test('HTTP: audio obtiene cargos con detalle y total 4300; sin configuración no consume cuota', async t => {
+  let calls = 0;
+  const server = createServer(createHandler(cfg(), { reserve: async () => calls++, provider: {
+    extract: async input => { assert.deepEqual(input.audio, audio); return data; },
+  } }));
+  server.listen(0, '127.0.0.1'); await once(server, 'listening');
+  t.after(() => new Promise(resolve => { server.closeAllConnections(); server.close(resolve); }));
+  const response = await fetch(`http://127.0.0.1:${server.address().port}/api/v1/readings`, {
+    method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ audio }),
+  });
+  assert.equal(response.status, 200);
+  const result = await response.json();
+  assert.equal(result.clientes[0].total_calculado, 4300);
+  assert.deepEqual(result.clientes[0].operaciones.map(op => op.detalle), ['cerveza', 'salchichas']);
+  assert.equal(result.requiere_confirmacion, true);
+  assert.equal(calls, 1);
+
+  const unconfigured = createServer(createHandler(cfg({ AUDIO_API_KEY: '' }), {
+    reserve: async () => assert.fail('No quota without audio config'), provider: { extract: async () => assert.fail('No provider') },
+  }));
+  unconfigured.listen(0, '127.0.0.1'); await once(unconfigured, 'listening');
+  t.after(() => new Promise(resolve => { unconfigured.closeAllConnections(); unconfigured.close(resolve); }));
+  const unavailable = await fetch(`http://127.0.0.1:${unconfigured.address().port}/api/v1/readings`, {
+    method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ audio }),
+  });
+  assert.equal(unavailable.status, 503);
+  assert.equal((await unavailable.json()).error.code, 'AUDIO_NOT_CONFIGURED');
+});
-- 
