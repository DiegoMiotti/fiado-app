+export function ensureAudio(config) {
+  if (!config.audioKey || !/^[a-zA-Z0-9._-]{1,120}$/.test(config.audioModel || ''))
+    throw new ApiError(503, 'AUDIO_NOT_CONFIGURED', 'Configurar AUDIO_API_KEY y AUDIO_MODEL de Gemini para procesar audio.');
+}
